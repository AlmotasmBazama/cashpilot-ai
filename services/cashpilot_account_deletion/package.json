{
  "name": "cashpilot-account-deletion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/app.test.ts tests/security.test.ts tests/account_deletion_store.test.ts tests/observability.test.ts",
    "test:emulator": "tsx --test tests/account_deletion_emulator.test.ts",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "secret-scan": "tsx scripts/secret_scan.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-admin": "^14.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.8.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "overrides": {
    "brace-expansion": "5.0.13",
    "glob": "14.0.6",
    "minimatch": "11.0.8",
    "rimraf": "6.1.3",
    "uuid": "11.1.1"
  }
}
