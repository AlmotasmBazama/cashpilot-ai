{
  "name": "cashpilot-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/architecture.test.ts tests/gateway.test.ts tests/security.test.ts tests/account_deletion_store.test.ts tests/response_parser.test.ts tests/provider_output_safety.test.ts tests/general_chat_safety.test.ts tests/tool_selection_response_safety.test.ts tests/financial_context_contract.test.ts tests/groq_completion.test.ts tests/groq_response_contracts.test.ts tests/tool_schema_contract.test.ts",
    "test:account-deletion:emulator": "tsx --test tests/account_deletion_emulator.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "secret-scan": "tsx scripts/secret_scan.ts",
    "verify-groq-models": "tsx scripts/verify-groq-models.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.8.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "overrides": {
    "brace-expansion": "5.0.13",
    "glob": "14.0.6",
    "minimatch": "11.0.8",
    "rimraf": "6.1.3",
    "uuid": "11.1.1"
  }
}
